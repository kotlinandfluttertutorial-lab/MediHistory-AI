# MediHistory AI — backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Security notes:
# - JWT_SECRET_KEY must be at least 32 random bytes (use: openssl rand -hex 32)
# - POSTGRES_PASSWORD must be a strong random password
# - GEMINI_API_KEY is optional; AI endpoints degrade gracefully when absent
# - Rotate JWT_SECRET_KEY and re-issue tokens after any suspected compromise

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=medihistory
POSTGRES_USER=medihistory_user
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# Full async SQLAlchemy URL (used by the app directly when not using docker-compose)
DATABASE_URL=postgresql+asyncpg://medihistory_user:CHANGE_ME_strong_random_password@localhost:5432/medihistory

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_at_least_32_random_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI (Gemini API) ───────────────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com
# Leave blank to disable AI endpoints (they return graceful fallback responses).
GEMINI_API_KEY=

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Server ────────────────────────────────────────────────────────────────────
WORKERS=2

# ── JWT RS256 (production recommended — overrides HS256 when set) ─────────────
# Generate with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
# Then set these to the file contents (use \n for newlines in single-line env):
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
