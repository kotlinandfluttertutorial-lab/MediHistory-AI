# =============================================================
# MediHistory AI — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file with real secrets to git.
# =============================================================

# === Android / Build ===
ANDROID_SDK_ROOT=
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# === Backend — Database ===
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# === Backend — Auth ===
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Backend — Storage ===
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
ENCRYPTION_KEY=

# === AI / OCR ===
OCR_PROVIDER=
OCR_API_ENDPOINT=
OCR_API_KEY=
AI_EXTRACTION_PROVIDER=
AI_EXTRACTION_API_KEY=
AI_NORMALIZATION_PROVIDER=
AI_NORMALIZATION_API_KEY=
AI_SUMMARIZATION_PROVIDER=
AI_SUMMARIZATION_API_KEY=

# === Cloud Backup (opt-in only) ===
CLOUD_BACKUP_ENABLED=false
CLOUD_BACKUP_BUCKET=
CLOUD_BACKUP_ENCRYPTION_KEY=

# === Medication Reference (F09, optional) ===
MED_REFERENCE_PROVIDER=
MED_REFERENCE_API_KEY=
MED_REFERENCE_API_ENDPOINT=

# === Testing ===
TEST_DB_URL=
TEST_JWT_SECRET=
