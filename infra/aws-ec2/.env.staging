# MediHistory AI — Staging environment template
# Copy this to .env and fill in all CHANGE_ME values.
# NEVER commit .env to version control.
#
# Generate JWT_SECRET_KEY:  openssl rand -hex 32
# Generate DB password:     openssl rand -base64 24

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=medihistory_staging
POSTGRES_USER=medihistory_user
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_here

# ── FastAPI / SQLAlchemy ──────────────────────────────────────────────────────
# This URL is used INSIDE the Docker network (db = container name)
DATABASE_URL=postgresql+asyncpg://medihistory_user:CHANGE_ME_strong_random_password_here@db:5432/medihistory_staging

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED — server will not start without this
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI (optional) ─────────────────────────────────────────────────────────────
# Leave blank to disable AI endpoints gracefully
GEMINI_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# 1 worker on t3.micro (1 GB RAM) — increase only if upgrading instance type
WORKERS=1

# ── Staging flag ──────────────────────────────────────────────────────────────
ENVIRONMENT=staging
# STAGING=true disables features that require external services not set up yet
